# ==================== 服务器基础配置 ====================
PORT=3000
# 会话密钥：请替换为随机长字符串（可使用 `openssl rand -hex 64` 生成）
SESSION_SECRET=your_random_secret_key_here
NODE_ENV=production

# ==================== 日志配置 ====================
LOG_LEVEL=info

# ==================== Session 存储配置 ====================
# Session 存储方式：true = SQLite（推荐，重启不掉线）/ false = MemoryStore（重启丢失会话）
USE_SQLITE_SESSION=true

# ==================== 邮件服务配置 ====================
# 默认使用 QQ 邮箱 SMTP，可自行替换为其他服务商
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_SECURE=true
# 请替换为你自己的 SMTP 账号信息（QQ 邮箱需使用授权码，而非登录密码）
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_authorization_code

# ==================== 安全与限流配置 ====================
# 单条聊天消息最大长度（字符）
MAX_MESSAGE_LENGTH=2000
# 聊天消息发送频率限制（毫秒/条）
MESSAGE_RATE_LIMIT_MS=300
# Socket 心跳间隔（毫秒）
HEARTBEAT_INTERVAL=30000
# Socket 心跳超时（毫秒），超过该时间无响应自动断开
HEARTBEAT_TIMEOUT=40000
# 邮件公告/更新公告邮件发送间隔（毫秒），防止被邮箱服务商标记为垃圾邮件
EMAIL_SEND_INTERVAL_MS=10000
