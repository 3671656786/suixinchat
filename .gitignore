# 依赖目录
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 数据库文件（用户部署时自动生成）
chat.db
chat.db-journal
chat.db-wal
chat.db-shm
notes.db
notes.db-journal
notes.db-wal
notes.db-shm
updates.db
updates.db-journal
updates.db-wal
updates.db-shm

# 环境变量（包含敏感信息）
.env
.env.local
.env.*.local

# 上传文件（保留目录结构，但排除实际文件）
uploads/
!uploads/.gitkeep

# 日志文件
logs/
*.log

# 系统文件
.DS_Store
Thumbs.db
*.tmp

# IDE 配置
.vscode/
.idea/
*.swp
*.swo

# PM2 日志
.pm2/

# 临时文件（根据你的项目）
cmd.bat
111.txt
agreement.txt
modify_requests/
clean_requests/

# 内部审查文档（不参与版本控制）
BUG清单.html
介绍词.html

# v4.0 本地参考源码与便携运行时（第三方代码，各有原许可证，不进入发布包）
discuzx/
.runtime/

# 工作区助手数据（含本机环境信息，不提交到公开仓库）
.workbuddy/

# v4 运行时数据与本地配置（含密钥，不进入发布包）
v4/data/*
!v4/data/.gitkeep
v4/config.local.php